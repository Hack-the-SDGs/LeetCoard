{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gdg-leetcode",
  "compatibility_date": "2024-12-01",
  // Without this, `wrangler deploy` publishes to gdg-leetcode.<subdomain>.workers.dev
  // — an origin the backend's CORS_ORIGINS does not name, so every request the
  // board makes is dropped by the browser and the projector just says 正在連線.
  "routes": [{ "pattern": "leetcode.ntust.camp", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
