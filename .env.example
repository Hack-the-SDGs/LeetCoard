# =============================================================================
# GDG on Campus NTUST — LeetCode 課堂練習計分板
# 複製成 `.env` 並填入實際值再啟動。
# =============================================================================

# ---- 管理員驗證 -------------------------------------------------------------
# 單一管理員 token。拿到這串字的人就能進控制台。
# 產生方式：`python -c "import secrets; print(secrets.token_urlsafe(32))"`
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---- 觀看密碼 ---------------------------------------------------------------
# 進入公開計分板需要的密碼。留空 = 任何拿到網址的人都看得到。
# 設定它可以避免學員直接從投影畫面或 API 讀到別人的作法。
#
# 控制台可以在上課中臨時覆寫這個值，覆寫只存在記憶體，伺服器重啟就回到這裡的
# 設定。改密碼會立刻中斷所有已連線的計分板。
VIEW_PASSWORD=

# ---- LeetCode session cookie ------------------------------------------------
# 逗號分隔的 LEETCODE_SESSION cookie，用來查 runtime 百分位（beat-%）。
# 填一組就能用；填多組會自動輪替，其中一組被限流時換下一組。
#
# 留空也可以跑，只是不會有 beat-% 加分，計分板上的百分位賽道會退回成單純的
# 解題者列表（基礎分照常計算）。
#
# 取得方式：登入 leetcode.com → DevTools → Application → Cookies
#           → LEETCODE_SESSION → Value
LEETCODE_SESSIONS=

# ---- LeetCode API -----------------------------------------------------------
LEETCODE_API_BASE=https://leetcode-api-pied.vercel.app

# ---- 狀態檔 -----------------------------------------------------------------
# 練習狀態的 JSON 存放位置，資料夾會自動建立。
DATA_DIR=./data

# ---- 輪詢 -------------------------------------------------------------------
# 輪詢跟著注意力走，不是跟著分數走：剛送出提交的人每 POLL_MIN_INTERVAL_SEC 查
# 一次，安靜下來的人以指數方式退到 POLL_MAX_INTERVAL_SEC。全部題目關閉時完全
# 不呼叫 API。
POLL_MIN_INTERVAL_SEC=5
POLL_MAX_INTERVAL_SEC=60
# 全體合計的請求上限（次/秒）。所有人同時活躍時系統會整體拉長間隔來守住它——
# 70 人 × 5 秒原本是 14 req/s，會被壓回這個數字。
POLL_MAX_RPS=6
# 每次輪詢抓幾筆最近提交。因為沒有提交次數上限，學員可能在一個間隔內連送多次。
POLL_RECENT_LIMIT=10
# 每個人的間隔加上的隨機抖動（0.0–1.0），避免請求擠在同一瞬間。
POLL_JITTER=0.2
# 同時在途的請求數上限。
POLL_CONCURRENCY=8
# 最後一題關閉後仍繼續輪詢的秒數，用來補抓延遲送達的提交。
POST_END_GRACE_SEC=90
# 對外 HTTP 逾時秒數。
LEETCODE_HTTP_TIMEOUT_SEC=10

# ---- CORS -------------------------------------------------------------------
# 逗號分隔的允許來源。`*` 只在本機開發時使用。
CORS_ORIGINS=https://leetcode.ntust.camp,http://localhost:5173
